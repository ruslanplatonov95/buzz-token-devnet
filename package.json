{
  "name": "buzz-devnet-token-test",
  "private": true,
  "type": "module",
  "description": "Devnet-only BUZZ token issuance, transfer-fee burn and operator-controlled staking demo. No real funds or sale.",
  "scripts": {
    "devnet:issue": "node issue.mjs",
    "devnet:fee": "node issue-fee-demo.mjs",
    "devnet:stake": "node staking-demo.mjs stake",
    "devnet:unstake": "node staking-demo.mjs unstake",
    "devnet:status": "node staking-demo.mjs status",
    "devnet:transfer": "node test-transfer.mjs",
    "devnet:burn": "node burn-worker.mjs --once",
    "devnet:watch": "node burn-worker.mjs --watch",
    "devnet:v3:issue": "node issue-v3.mjs",
    "devnet:v3:stake": "node staking-v3.mjs stake",
    "devnet:v3:unstake": "node staking-v3.mjs unstake",
    "devnet:v3:status": "node staking-v3.mjs status",
    "economics:v3": "node economics-v3.mjs",
    "test": "node --test economics-v3.test.mjs"
  },
  "dependencies": {
    "@solana/spl-token": "0.4.15",
    "@solana/spl-token-metadata": "^0.1.6",
    "@solana/web3.js": "^1.99.0"
  }
}
